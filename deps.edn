{:paths ["src" "resources" "vim"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; Result ADT for every verb outcome.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.29"}

        ;; HVCP value objects and verb params are malli schemas.
        metosin/malli {:mvn/version "0.20.1"}

        ;; IAddon + IVessel contracts. The addon never compiles against a host.
        io.github.hive-agi/hive-addon {:mvn/version "1.0.12"}

        ;; IEditorPort family: the host-facing verb contract this addon reifies.
        io.github.hive-agi/hive-spi {:mvn/version "1.1.1"}

        ;; Vessel registry the addon composes through hooks. Git-pinned until
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.7"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.3"}
                io.github.hive-agi/hive-schemas {:mvn/version "0.1.35"}
                io.github.hive-agi/hive-test {:mvn/version "0.4.7"}}
   :main-opts ["-m" "cognitect.test-runner"]}

  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.19"}}
   :ns-default hive-build.api}}}
